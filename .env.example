# Gere uma chave exclusiva para este ambiente:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cookie seguro deve permanecer true quando publicado atrás de HTTPS.
COOKIE_SECURE=true

# Porta publicada na máquina do host.
HOST_PORT=8000

# Opcional. Vazio usa o ano do calendário; defina se o calendário letivo for diferente.
SCHOOL_YEAR=
